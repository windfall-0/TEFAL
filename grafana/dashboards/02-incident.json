  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "사건 요약",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "tefal-backend"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "tefal-backend"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/incidents/${trace_id}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "status_text",
              "text": "상태",
              "type": "string"
            },
            {
              "selector": "workload",
              "text": "워크로드",
              "type": "string"
            },
            {
              "selector": "runtime_detail",
              "text": "런타임",
              "type": "string"
            },
            {
              "selector": "time_text",
              "text": "시작",
              "type": "string"
            },
            {
              "selector": "mitre_text",
              "text": "MITRE",
              "type": "string"
            },
            {
              "selector": "src_ip",
              "text": "출발지 IP",
              "type": "string"
            }
          ],
          "filters": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
