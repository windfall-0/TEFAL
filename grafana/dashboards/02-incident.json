        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 12,
          "valueSize": 18
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "trace_id를 입력하세요"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "← 사건 큐",
          "url": "/d/tefal-overview?from=now-1h&to=now"
        }
      ]
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Trace View · 계층별 인과 흐름",
      "description": "출처: Tempo. span을 누르면 binary/args, policy·action, exec_id/parent를 볼 수 있습니다. 계층: app·uprobe → proc → kernel·LSM → falco",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 15,
        "h": 15
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo-ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo-ds"
          },
          "queryType": "traceql",
          "query": "${trace_id}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "timeFrom": "7d",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "marcusolsson-dynamictext-panel",
      "title": "AI 해석 · 대응 가이드",
      "description": "Gemini가 근거 로그를 바탕으로 생성. 다시 분석하려면 상단 변수 'AI 다시 분석'을 '예'로 바꾸세요.",
      "gridPos": {
        "x": 15,
        "y": 4,
        "w": 9,
        "h": 15
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "tefal-backend"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "tefal-backend"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/ai/analysis/${trace_id}?refresh=${ai_refresh}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "markdown",
              "text": "markdown",
              "type": "string"
            }
          ],
          "filters": []
        }
      ],
      "options": {
        "renderMode": "everyRow",
        "content": "{{{markdown}}}",
        "defaultContent": "분석 결과가 없습니다.",
        "editors": [
          "helpers"
        ],
        "contentPartials": [],
        "helpers": "",
        "styles": "",
        "wrap": true,
        "editor": {
          "language": "markdown",
          "format": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "원본 로그 · 이 사건에 속한 이벤트",
      "description": "출처: Loki · exec_id 와 parent exec_id 로 필터. 숫자(시각 등)만 다른 연속 줄은 한 줄로 접어 반복 횟수를 표시합니다 (중복 제거: Numbers)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "${loki_selector} |= `\"exec_id\":\"${exec_id}\"`",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "${loki_selector} |= `\"exec_id\":\"${parent_exec_id}\"`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "numbers",
        "sortOrder": "Ascending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "출발지 IP 요약",
