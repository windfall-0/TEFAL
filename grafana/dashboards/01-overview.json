    {
      "id": 4,
      "type": "stat",
      "title": "수집 상태",
      "description": "DaemonSet Ready 비율과 Alloy/Loki/Tempo scrape 상태. 1이면 정상입니다.",
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_daemonset_status_number_ready{daemonset=~\".*tetragon.*\"}) / sum(kube_daemonset_status_desired_number_scheduled{daemonset=~\".*tetragon.*\"})",
          "legendFormat": "Tetragon",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_daemonset_status_number_ready{daemonset=~\".*falco.*\"}) / sum(kube_daemonset_status_desired_number_scheduled{daemonset=~\".*falco.*\"})",
          "legendFormat": "Falco",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up{job=~\".*(alloy|loki|tempo).*\"})",
          "legendFormat": "Alloy → Loki / Tempo",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "text": "정상",
                  "color": "#73BF69",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -1000000000.0,
                "to": 0.9999,
                "result": {
                  "text": "이상",
                  "color": "#FF7383",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "수신 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF7383",
                "value": null
              },
              {
                "color": "#73BF69",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
