  "templating": {
    "list": [
      {
        "type": "query",
        "name": "namespace",
        "label": "namespace",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": "All",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "runtime",
        "label": "runtime",
        "hide": 0,
        "query": "Java,PHP,Node",
        "multi": true,
        "includeAll": true,
        "options": [],
        "allValue": "All",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "custom",
        "name": "status",
        "label": "상태",
        "hide": 0,
        "query": "차단됨 : blocked,미차단 : unblocked,판정 중 : pending",
        "multi": false,
        "includeAll": true,
        "options": [],
        "allValue": "All",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "custom",
        "name": "level",
        "label": "단계",
        "hide": 0,
        "query": "Critical : critical,High : high,Medium : medium,Low : low,Info : informational",
        "multi": true,
        "includeAll": true,
        "options": [],
        "allValue": "All",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "constant",
        "name": "hubble_url",
        "label": "Hubble UI URL",
        "hide": 2,
        "query": "http://192.168.0.200:31235",
        "current": {
          "text": "http://192.168.0.200:31235",
          "value": "http://192.168.0.200:31235"
