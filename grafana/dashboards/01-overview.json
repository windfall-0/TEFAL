llipsis}.tf-cell.lv1{background:#DCE8FD;color:#1E3A8A}.tf-cell.lv2{background:#A9C7F9;color:#0F2A6B}.tf-cell.lv3{background:#2F64D6;color:#FFFFFF}.tf-cell.zero,.tf-cell.none{background:#F3F4F6;color:#4B5563}.tf-cell.recent{outline:2px solid #F76808;animation:tfPulse 1.6s infinite}.tf-arrow{width:18px;height:12px;justify-self:center;background-color:#D1D5DB;clip-path:polygon(0 5px,13.6px 5px,10.2px 1.6px,11.6px .2px,17.4px 6px,11.6px 11.8px,10.2px 10.4px,13.6px 7px,0 7px)}.tf-arrow.on{background-color:#9CA3AF;background-image:linear-gradient(90deg,transparent,#2F64D6,transparent);background-repeat:no-repeat;background-size:6px 12px;background-position:-6px 0;animation:tfGlow 2.6s ease-in-out infinite}.tf-wall{justify-self:center;width:11px;height:11px;margin-right:5px;border-top:3.5px solid #0E2C6E;border-right:3.5px solid #0E2C6E;transform:rotate(45deg)}.tf-result{display:flex;align-items:center;justify-content:space-between;background:#9EDB8F;color:#0E3B1A;border:1px solid #5DB55A;border-radius:8px;padding:6px 10px;font-size:12px}.tf-result b{font-size:15px}.tf-result small{color:#24562A;font-size:12px}.tf-falrow{display:grid;grid-template-columns:64px 58px minmax(0,1fr) 150px;column-gap:4px;align-items:center}.tf-dash{display:flex;align-items:center;gap:10px;color:#6B7280;font-size:12px;margin-left:22px}.tf-dash i{flex:1;height:2px;background:repeating-linear-gradient(90deg,#F3A5A8 0 6px,transparent 6px 12px);animation:tfDash 3s linear infinite}.tf-unblocked{display:flex;align-items:center;justify-content:center;background:#E5484D;color:#FFFFFF;border-radius:8px;padding:7px 10px;font-size:15px;font-weight:700}.tf-unblocked.zero{background:#F3F4F6;color:#4B5563}.tf-feed{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;border-left:1px solid #E5E7EB;padding-left:20px}.tf-feedhead{display:flex;justify-content:space-between;font-size:11px;color:#4B5563;font-weight:600}.tf-feedhead a{color:#1F60C4}.tf-item{display:grid;grid-template-columns:64px 54px minmax(0,1fr) auto;gap:8px;align-items:center;padding:6px 8px;border-radius:6px;border:1px solid #F3F4F6}.tf-item:hover{border-color:#D1D5DB}.tf-item.new{border-color:#FFD8B8;animation:tfIn .6s ease-out 1,tfNew 2.4s ease-out .6s 1 both}.tf-time{font-size:12px;color:#374151;font-variant-numeric:tabular-nums}.tf-svc{font-size:11px;font-weight:700;color:#1E3A8A;background:#DCE8FD;border-radius:4px;padding:2px 6px;text-align:center}.tf-svc.falco{color:#9B1C1F;background:#FDE2E3}.tf-path{font-size:12px;color:#374151;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tf-path b{color:#1F4FB8}.tf-badge{font-size:11px;font-weight:700;color:#0E3B1A;background:#9EDB8F;border:1px solid #5DB55A;border-radius:999px;padding:2px 8px}.tf-badge.bad{color:#FFFFFF;background:#E5484D;border-color:#E5484D}.tf-empty{font-size:12px;color:#6B7280;padding:8px}@keyframes tfPulse{0%{box-shadow:0 0 0 0 rgba(247,104,8,.55)}70%{box-shadow:0 0 0 8px rgba(247,104,8,0)}100%{box-shadow:0 0 0 0 rgba(247,104,8,0)}}@keyframes tfGlow{0%{background-position:-6px 0}100%{background-position:18px 0}}@keyframes tfDash{to{background-position:24px 0}}@keyframes tfIn{0%{transform:translateY(-8px);opacity:0}100%{transform:none;opacity:1}}@keyframes tfNew{0%{background:#FFF1E6}100%{background:#FFFFFF}}",
        "wrap": false,
        "editor": {
          "language": "html",
          "format": "auto"
        }
      },
